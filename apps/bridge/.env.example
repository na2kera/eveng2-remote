BRIDGE_HOST=127.0.0.1
BRIDGE_PORT=8787
BRIDGE_CLIENT_TOKEN=replace-with-a-long-random-client-token
BRIDGE_HOOK_TOKEN=replace-with-a-different-long-random-hook-token
BRIDGE_TLS_CERT_PATH=
BRIDGE_TLS_KEY_PATH=

WHISPER_URL=http://127.0.0.1:8080/inference
WHISPER_LANGUAGE=ja
WHISPER_PROMPT=Claude Code, Codex, cmux, TypeScript, Vite, useEffect, package.json, npm
WHISPER_TIMEOUT_MS=120000
MAX_WHISPER_RESPONSE_BYTES=65536
MAX_RECORDING_SECONDS=30
MAX_CLIENTS=4
MAX_PENDING_PERMISSIONS=32
MAX_CONCURRENT_TRANSCRIPTIONS=1

CMUX_BIN=/Applications/cmux.app/Contents/Resources/bin/cmux
CMUX_DEFAULT_SURFACE=
CMUX_DEFAULT_WORKSPACE=
PERMISSION_TTL_MS=60000
